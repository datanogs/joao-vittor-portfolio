      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Artistas com #1",
      "Expression": "\n        COUNTROWS(\n            FILTER(\n                VALUES('Base de dados - Spotify - TOP50'[artist]),\n                CALCULATE(MIN('Base de dados - Spotify - TOP50'[position])) = 1\n            )\n        )",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Artistas com Top 10",
      "Expression": "\n        COUNTROWS(\n            FILTER(\n                VALUES('Base de dados - Spotify - TOP50'[artist]),\n                CALCULATE(MIN('Base de dados - Spotify - TOP50'[position])) <= 10\n            )\n        )",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Artistas Distintos por Dia",
      "Expression": "\n        DIVIDE([Total Artistas Distintos], [Dias Monitorados])",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Capa de Álbum Disponível",
      "Expression": "\n        CALCULATE(\n            COUNTROWS('Base de dados - Spotify - TOP50'),\n            NOT ISBLANK('Base de dados - Spotify - TOP50'[album_cover_url])\n        )",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Data de Lançamento Mais Antiga",
      "Expression": "\n        MIN('Base de dados - Spotify - TOP50'[release_date])",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Data de Lançamento Mais Recente",
      "Expression": "\n        MAX('Base de dados - Spotify - TOP50'[release_date])",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Data Final Ranking",
      "Expression": "\n        MAX('Base de dados - Spotify - TOP50'[date])",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
