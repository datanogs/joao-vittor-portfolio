      "Expression": "\n        DIVIDE(SUM('Base de dados - Spotify - TOP50'[duration_ms]), 3600000)",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Entradas em #1",
      "Expression": "\n        CALCULATE(\n            COUNTROWS('Base de dados - Spotify - TOP50'),\n            'Base de dados - Spotify - TOP50'[position] = 1\n        )",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Entradas Top 10",
      "Expression": "\n        CALCULATE(\n            COUNTROWS('Base de dados - Spotify - TOP50'),\n            'Base de dados - Spotify - TOP50'[position] <= 10\n        )",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Entradas Top 50",
      "Expression": "\n        CALCULATE(\n            COUNTROWS('Base de dados - Spotify - TOP50'),\n            'Base de dados - Spotify - TOP50'[position] <= 50\n        )",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Idade Média das Faixas (anos)",
      "Expression": "\n        DIVIDE([Idade Média das Faixas (dias)], 365)",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Idade Média das Faixas (dias)",
      "Expression": "\n        AVERAGEX(\n            'Base de dados - Spotify - TOP50',\n            DATEDIFF(\n                'Base de dados - Spotify - TOP50'[release_date],\n                'Base de dados - Spotify - TOP50'[date],\n                DAY\n            )\n        )",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Índice de Performance Artista",
      "Expression": "\n        [Popularidade Média por Artista] * DIVIDE(51 - [Posição Média por Artista], 50)",
