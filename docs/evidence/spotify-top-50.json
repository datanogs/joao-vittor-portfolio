    },
    {
      "TableName": "Medidas",
      "Name": "Diferença Popularidade Explícitas vs Não",
      "Expression": "\n        [Popularidade Média Explícitas] - [Popularidade Média Não Explícitas]",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Duração Máxima (min)",
      "Expression": "\n        DIVIDE(MAX('Base de dados - Spotify - TOP50'[duration_ms]), 60000)",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Duração Média (min)",
      "Expression": "\n        DIVIDE([Duração Média (ms)], 60000)",
      "DisplayFolder": null,
      "Description": null
    },
    {
      "TableName": "Medidas",
      "Name": "Duração Média (ms)",
      "Expression": "\n        AVERAGE('Base de dados - Spotify - TOP50'[duration_ms])",
      "DisplayFolder": null,
      "Description": null
    },
    {
